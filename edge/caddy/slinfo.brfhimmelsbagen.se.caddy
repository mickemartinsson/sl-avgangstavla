slinfo.brfhimmelsbagen.se {
	root * /var/www/slinfo
	# index: skärmarna (Axema C205) pekar historiskt på roten, som på Loopia
	# redirectades av index.php. På edgen finns ingen PHP — utan detta ger / 404.
	file_server {
		index display.html
	}
	encode gzip
	header Cache-Control "no-cache"
	log {
		output file /var/log/caddy/slinfo.log
	}
}
